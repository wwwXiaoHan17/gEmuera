{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemuera.local/schema/m0-dialect-signature-inventory-1.0.0.json",
  "title": "gEmuera M0 dialect signature inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workPackage", "generatedAtUtc", "executionStatus", "gateStatus", "blockerCode", "result", "sourceInventoryHash", "descriptorSetHash", "instructionCount", "expressionFunctionCount", "coverage", "uncovered", "sourceFiles", "instructions", "expressionFunctions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workPackage": { "const": "M0-DIA-03" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "executionStatus": { "const": "InProgress" },
    "gateStatus": { "const": "Blocked" },
    "blockerCode": { "const": "EvidenceMissing" },
    "result": { "const": "Partial" },
    "sourceInventoryHash": { "$ref": "#/$defs/sha256" },
    "descriptorSetHash": { "$ref": "#/$defs/sha256" },
    "instructionCount": { "type": "integer", "minimum": 1 },
    "expressionFunctionCount": { "type": "integer", "minimum": 1 },
    "coverage": { "$ref": "#/$defs/coverage" },
    "uncovered": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "sourceFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceFile" } },
    "instructions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/instruction" } },
    "expressionFunctions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/function" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["Resolved", "Conditional", "Unresolved"] },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFile", "sha256", "bytes"],
      "properties": {
        "sourceFile": { "type": "string", "pattern": "^scripts/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructionRegistrationSourceResolvedCount", "instructionBindingUnknownCount", "instructionArgumentResolvedCount", "instructionArgumentConditionalCount", "instructionArgumentUnresolvedCount", "instructionInputWaitCandidateCount", "expressionHandlerSourceResolvedCount", "expressionReturnResolvedCount", "expressionReturnConditionalCount", "expressionReturnUnresolvedCount", "expressionArgumentResolvedCount", "expressionArgumentConditionalCount", "expressionArgumentUnresolvedCount", "expressionCompleteStaticCount"],
      "properties": {
        "instructionRegistrationSourceResolvedCount": { "$ref": "#/$defs/count" },
        "instructionBindingUnknownCount": { "$ref": "#/$defs/count" },
        "instructionArgumentResolvedCount": { "$ref": "#/$defs/count" },
        "instructionArgumentConditionalCount": { "$ref": "#/$defs/count" },
        "instructionArgumentUnresolvedCount": { "$ref": "#/$defs/count" },
        "instructionInputWaitCandidateCount": { "$ref": "#/$defs/count" },
        "expressionHandlerSourceResolvedCount": { "$ref": "#/$defs/count" },
        "expressionReturnResolvedCount": { "$ref": "#/$defs/count" },
        "expressionReturnConditionalCount": { "$ref": "#/$defs/count" },
        "expressionReturnUnresolvedCount": { "$ref": "#/$defs/count" },
        "expressionArgumentResolvedCount": { "$ref": "#/$defs/count" },
        "expressionArgumentConditionalCount": { "$ref": "#/$defs/count" },
        "expressionArgumentUnresolvedCount": { "$ref": "#/$defs/count" },
        "expressionCompleteStaticCount": { "$ref": "#/$defs/count" }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicKey", "targetModule", "registrationSourceStatus", "registrationApi", "registrationExpression", "bindingKind", "handlerType", "handlerSourceStatus", "handlerSourceFile", "handlerSourceLine", "argumentSchemaStatus", "argumentSchemaCandidates", "registrationFlagExpression", "handlerFlagCandidates", "completionModeCandidate", "effectCandidates", "evidenceStatus", "behaviorFixtureStatus"],
      "properties": {
        "publicKey": { "type": "string", "minLength": 1 },
        "targetModule": { "type": "string", "minLength": 1 },
        "registrationSourceStatus": { "enum": ["Resolved", "Unresolved"] },
        "registrationApi": { "type": "string" },
        "registrationExpression": { "type": "string" },
        "bindingKind": { "enum": ["ArgumentBuilderFactory", "ArgumentBuilderTable", "GeneratedInstructionHandler", "InstructionHandler", "Unknown"] },
        "handlerType": { "type": "string" },
        "handlerSourceStatus": { "enum": ["Resolved", "Ambiguous", "Unresolved"] },
        "handlerSourceFile": { "type": "string" },
        "handlerSourceLine": { "type": "integer", "minimum": 0 },
        "argumentSchemaStatus": { "$ref": "#/$defs/status" },
        "argumentSchemaCandidates": { "$ref": "#/$defs/stringArray" },
        "registrationFlagExpression": { "type": "string" },
        "handlerFlagCandidates": { "$ref": "#/$defs/stringArray" },
        "completionModeCandidate": { "enum": ["ControlFlowCandidate", "InputWaitCandidate", "SynchronousCandidate", "TimedYieldCandidate", "Unresolved"] },
        "effectCandidates": { "$ref": "#/$defs/stringArray" },
        "evidenceStatus": { "const": "StaticCandidate" },
        "behaviorFixtureStatus": { "const": "Uncovered" }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicKey", "targetModule", "handlerType", "handlerSourceStatus", "handlerSourceFile", "handlerSourceLine", "returnTypeStatus", "returnTypeCandidates", "argumentSchemaStatus", "argumentSchemaCandidates", "signatureStatus", "overridesArgumentCheck", "restructureCandidates", "completionModeCandidate", "effectCandidates", "evidenceStatus", "behaviorFixtureStatus"],
      "properties": {
        "publicKey": { "type": "string", "minLength": 1 },
        "targetModule": { "type": "string", "minLength": 1 },
        "handlerType": { "type": "string", "minLength": 1 },
        "handlerSourceStatus": { "enum": ["Resolved", "Ambiguous", "Unresolved"] },
        "handlerSourceFile": { "type": "string" },
        "handlerSourceLine": { "type": "integer", "minimum": 0 },
        "returnTypeStatus": { "$ref": "#/$defs/status" },
        "returnTypeCandidates": { "$ref": "#/$defs/stringArray" },
        "argumentSchemaStatus": { "$ref": "#/$defs/status" },
        "argumentSchemaCandidates": { "$ref": "#/$defs/stringArray" },
        "signatureStatus": { "enum": ["CompleteStatic", "ConditionalStatic", "Unresolved"] },
        "overridesArgumentCheck": { "type": "boolean" },
        "restructureCandidates": { "$ref": "#/$defs/stringArray" },
        "completionModeCandidate": { "enum": ["SynchronousBodyCandidate", "Unresolved"] },
        "effectCandidates": { "$ref": "#/$defs/stringArray" },
        "evidenceStatus": { "const": "StaticCandidate" },
        "behaviorFixtureStatus": { "const": "Uncovered" }
      }
    }
  }
}
