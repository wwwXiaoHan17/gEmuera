<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Core\GEmuera.Core.csproj" />
    <!-- Program.cs 直名契约类型（CompatPackManifest.TryParse）：2026-10-03 拆分后显式
         引用契约程序集 Emuera.CompatPack，不依赖传递引用。 -->
    <ProjectReference Include="..\..\..\src\EmueraCompatPack\EmueraCompatPack.csproj" />
    <!-- v18 第一方数据包：等价门禁经真实包 DLL（内嵌生成清单）走完整加载/组装链。 -->
    <ProjectReference Include="..\..\..\packs\pack.gemuera.v18\pack.gemuera.v18.csproj" />
    <!-- 运行时对照：生成清单 MethodProjectedInstructionNames 必须与引擎真实注册表投影一致
         （经反射访问 internal FunctionIdentifier.GetInstructionNameDic，不需要 IVT）。 -->
    <ProjectReference Include="..\..\..\gemuera-c#.csproj" />
    <Compile Include="..\..\..\Scripts\Emuera\Compatibility\LegacyCompatibilityProfile.cs" Link="LegacyCompatibilityProfile.cs" />
    <Compile Include="..\..\..\Scripts\Emuera\Compatibility\LegacyCompatibilityModules.cs" Link="LegacyCompatibilityModules.cs" />
  </ItemGroup>
</Project>
