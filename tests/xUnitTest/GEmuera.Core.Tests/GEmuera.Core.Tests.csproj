<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GEmuera.Core.Tests</RootNamespace>
    <AssemblyName>GEmuera.Core.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Core\GEmuera.Core.csproj" />
    <!-- 数据包夹具：无 ICompatPack 入口，仅内嵌 manifest（manifest-only 加载路径端到端）。 -->
    <ProjectReference Include="..\DataOnlyCompatPackFixture\DataOnlyCompatPackFixture.csproj" />
    <!-- 社区包模板（packs/，manifest-only 数据包脚手架）。 -->
    <ProjectReference Include="..\..\..\packs\CommunityPackTemplate\CommunityPackTemplate.csproj" />
    <!-- v18 第一方数据包（packs/，生成清单差量的端到端等价门禁）。 -->
    <ProjectReference Include="..\..\..\packs\gemuera.v18\gemuera.v18.csproj" />
    <!-- 契约夹具：只引用 Emuera 契约程序集的最小 ICompatPack 样本（ALC 正向用例复用）。 -->
    <ProjectReference Include="..\CompatPackContractOnlyFixture\CompatPackContractOnlyFixture.csproj" />
    <!-- 多入口夹具（M9）：同一程序集两个 ICompatPack 实现类，钉住"恰好一个入口"拒载。 -->
    <ProjectReference Include="..\CompatPackDoubleEntryFixture\CompatPackDoubleEntryFixture.csproj" />
    <!-- 加载器全链路夹具（T5 起测试程序集不再兼任包样本）：入口类 + 表面/能力贡献，
         程序集只引用契约程序集，隔离目录加载时 GetTypes 可完整枚举。 -->
    <ProjectReference Include="..\HelloCompatPackFixture\HelloCompatPackFixture.csproj" />
    <!-- 类型加载失败负向夹具：入口类继承坏依赖基类，坏依赖字节导致 GetTypes 失败。 -->
    <ProjectReference Include="..\CompatPackTypeLoadFixture\CompatPackTypeLoadFixture.csproj" />
    <!-- 宿主绑定探针（负向夹具）：故意引用 GEmuera.Core，钉住 ALC 允许清单 fail-closed 拒载。 -->
    <ProjectReference Include="..\CompatPackHostBindingProbe\CompatPackHostBindingProbe.csproj" />
    <!-- 旧 facade 包夹具（T8）：只引用 src/EmueraFacade；测试把二进制 AssemblyRef 改写成
         拆分前形态后验证 facade 预载成功 / 干净进程拒载两向。 -->
    <ProjectReference Include="..\CompatPackLegacyFacadeFixture\CompatPackLegacyFacadeFixture.csproj" />
    <!-- 干净进程探针（T8）：只引用 GEmuera.Core（不引用 facade）；测试经 dotnet exec 启动，
         程序集随 ProjectReference 复制到测试输出（不静态调用其入口点）。 -->
    <ProjectReference Include="..\CompatPackLegacyFacadeProbe\CompatPackLegacyFacadeProbe.csproj" />
  </ItemGroup>
  <!-- T5 起测试程序集不再兼任"包样本"（内嵌清单已移入 HelloCompatPackFixture）：
       测试程序集引用 xunit/Core，隔离 ALC 的 GetTypes 会因无关类型加载失败而触发 fail-closed。 -->
</Project>
