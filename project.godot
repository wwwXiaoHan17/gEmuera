; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="gemuera-c#"
run/main_scene="res://first_window.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "C#", "Mobile")
prototype_runtime=true
typed_ports=true
pixel_store=true

[autoload]

AppBootstrap="*res://Scripts/GodotHost/AppBootstrap.cs"
PlatformGateway="*res://Scripts/GodotHost/PlatformGateway.cs"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="gemuera-c#"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/markdownlabel/plugin.cfg")

[launcher]

default_game_library="E:/MyCode/Era"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
