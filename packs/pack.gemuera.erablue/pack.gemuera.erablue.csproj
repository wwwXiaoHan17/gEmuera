<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>pack.gemuera.erablue</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- erablue 第一方数据包：+SETANIMETIMER 指令面 + 启动容错 capability。
         plugin.external-assembly.v1 是 DiagnosticOnly（无运行期消费者），不可入包。 -->
    <EmbeddedResource Include="compatpack.manifest.json" LogicalName="compatpack.manifest.json" />
  </ItemGroup>
</Project>
