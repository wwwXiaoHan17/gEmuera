<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>gemuerac</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);.godot/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- The pure Core contracts are consumed by the Godot host through net8.0. -->
    <ProjectReference Include="src\Core\GEmuera.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="uEmuera-0.2.9d\**" />
    <EmbeddedResource Remove="uEmuera-0.2.9d\**" />
    <None Remove="uEmuera-0.2.9d\**" />
    <Compile Remove="XEmuera-0.5.1\**" />
    <EmbeddedResource Remove="XEmuera-0.5.1\**" />
    <None Remove="XEmuera-0.5.1\**" />
    <!-- The future Core assembly is built independently and must not leak into the Godot host glob. -->
    <Compile Remove="src\Core\**" />
    <EmbeddedResource Remove="src\Core\**" />
    <None Remove="src\Core\**" />
    <Compile Remove="tools\core-contracts\**" />
    <EmbeddedResource Remove="tools\core-contracts\**" />
    <None Remove="tools\core-contracts\**" />
    <Compile Remove="tools\dialect-inventory\**" />
    <EmbeddedResource Remove="tools\dialect-inventory\**" />
    <None Remove="tools\dialect-inventory\**" />
    <!-- Diagnostics config smoke links host sources with Godot stubs; never compile them into the Godot host. -->
    <Compile Remove="tools\diagnostics-config-smoke\**" />
    <EmbeddedResource Remove="tools\diagnostics-config-smoke\**" />
    <None Remove="tools\diagnostics-config-smoke\**" />
    <!-- xUnit tests build independently via their own csproj; keep them out of the Godot host glob. -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <!-- Evidence and upstream builds are generated data, never Godot host source. -->
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <!-- Godot's editor-generated C# intermediates are not source files. -->
    <Compile Remove=".godot\**" />
    <EmbeddedResource Remove=".godot\**" />
    <None Remove=".godot\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup Condition=" '$(GodotTargetPlatform)' == 'android' ">
	<PackageDownload Include="SkiaSharp.NativeAssets.Android" Version="[2.88.8]" />
	<!-- Godot 的 android 构建是纯 net9.0+RID，不会走 net6.0-android31.0 依赖组，
	     bundle_e_sqlite3 的 android 传递依赖（含 libe_sqlite3.so 的 .aar）永远拉不进缓存。
	     用 PackageDownload 强制下载，供 RestoreAndroidSqliteNativeLibrary 自愈提取（2026-09-07 实证）。 -->
	<PackageDownload Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="[2.1.12]" />
    <None Include="Build\NativeLibs\android\arm64-v8a\libe_sqlite3.so" CopyToOutputDirectory="PreserveNewest" TargetPath="libe_sqlite3.so" />
	<None Include="$(NuGetPackageRoot)skiasharp.nativeassets.android\2.88.8\runtimes\android-arm64\native\libSkiaSharp.so" CopyToOutputDirectory="PreserveNewest" TargetPath="libSkiaSharp.so" />
  </ItemGroup>

  <!-- Build/NativeLibs/ 已被 gitignore（编译产物不入库）。Android 构建前如缺失，
       从 SQLitePCLRaw 的 NuGet 缓存 .aar 中自愈提取 jni/arm64-v8a/libe_sqlite3.so。 -->
  <Target Name="RestoreAndroidSqliteNativeLibrary" BeforeTargets="Build" Condition=" '$(GodotTargetPlatform)' == 'android' And !Exists('Build\NativeLibs\android\arm64-v8a\libe_sqlite3.so') ">
    <ItemGroup>
      <_SqliteAar Include="$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3.android\**\lib\net6.0-android31.0\SQLitePCLRaw.lib.e_sqlite3.android.aar" />
    </ItemGroup>
    <PropertyGroup>
      <_SqliteAarPath>@(_SqliteAar->'%(FullPath)', ';')</_SqliteAarPath>
    </PropertyGroup>
    <Warning Condition=" '$(_SqliteAarPath)' == '' "
             Text="SQLitePCLRaw android .aar not found in NuGet cache; Build/NativeLibs/android/arm64-v8a/libe_sqlite3.so will not be restored. Run 'dotnet restore' first." />
    <Exec Condition=" '$(_SqliteAarPath)' != '' "
          Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$aar='$(_SqliteAarPath)'; $tmp=[System.IO.Path]::GetTempFileName(); [System.IO.File]::Copy($aar,$tmp,$true); $out='$(MSBuildProjectDirectory)\Build\NativeLibs\android\arm64-v8a'; New-Item -ItemType Directory -Force -Path $out | Out-Null; Add-Type -AssemblyName System.IO.Compression.FileSystem; $z=[System.IO.Compression.ZipFile]::OpenRead($tmp); $e=$z.Entries | Where-Object { $_.FullName -eq 'jni/arm64-v8a/libe_sqlite3.so' }; if($e){ [System.IO.Compression.ZipFileExtensions]::ExtractToFile($e,(Join-Path $out 'libe_sqlite3.so'),$true) }; $z.Dispose(); Remove-Item $tmp -Force&quot;" />
  </Target>

  <Target Name="CopyAndroidSqliteNativeLibrary" AfterTargets="Build" Condition=" '$(GodotTargetPlatform)' == 'android' And Exists('Build\NativeLibs\android\arm64-v8a\libe_sqlite3.so') ">
    <Copy SourceFiles="Build\NativeLibs\android\arm64-v8a\libe_sqlite3.so" DestinationFiles="$(OutputPath)libe_sqlite3.so" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyAndroidSkiaSharpNativeLibrary" AfterTargets="Build" Condition=" '$(GodotTargetPlatform)' == 'android' And Exists('$(NuGetPackageRoot)skiasharp.nativeassets.android\2.88.8\runtimes\android-arm64\native\libSkiaSharp.so') ">
    <Copy SourceFiles="$(NuGetPackageRoot)skiasharp.nativeassets.android\2.88.8\runtimes\android-arm64\native\libSkiaSharp.so" DestinationFiles="$(OutputPath)libSkiaSharp.so" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ExcludeGodotEditorIntermediates" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="$(MSBuildProjectDirectory)\.godot\**\*.cs" />
    </ItemGroup>
  </Target>
</Project>
